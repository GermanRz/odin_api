# ==============================================================================
# ODIN - Archivo de Exclusión de Git (.gitignore)
# ==============================================================================

# Plantilla y recursos fuente de AdminLTE (no trackear descarga completa)
AdminLTE*/
AdminLTE-3.2.0/
varios/

# ------------------------------------------------------------------------------
# Archivos de Entorno, Configuración Local y Secretos
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.config.local.php

# ------------------------------------------------------------------------------
# Dependencias y Gestores de Paquetes
# ------------------------------------------------------------------------------
vendor/
node_modules/

# ------------------------------------------------------------------------------
# Entornos de Desarrollo e IDEs (Configuraciones de usuario)
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PhpStorm
.idea/
*.iml
*.iws

# Otros editores y sistemas
.project
.buildpath
.settings/
nbproject/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Archivos del Sistema Operativo
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ------------------------------------------------------------------------------
# Logs, Caché y Archivos Temporales
# ------------------------------------------------------------------------------
*.log
error_log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------------------------------------------
# Archivos subidos y almacenamiento temporal de usuarios
# ------------------------------------------------------------------------------
vistas/archivos/*
!vistas/archivos/.gitkeep